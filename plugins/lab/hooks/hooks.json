{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_banner.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session_banner.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/save_response.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/save_response.py\""
          }
        ]
      }
    ]
  }
}
